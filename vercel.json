{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "/api/backend/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/:path*"
    }
  ]
}
