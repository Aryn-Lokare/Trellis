{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "routes": [
    {
      "src": "/api/backend/(.*)",
      "dest": "/api/backend/$1",
      "service": "backend"
    },
    {
      "src": "/(.*)",
      "dest": "/$1",
      "service": "frontend"
    }
  ]
}
