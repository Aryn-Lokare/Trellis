{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": {
        "type": "service",
        "service": "backend",
        "path": "/backend/:path*"
      }
    }
  ]
}
